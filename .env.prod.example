# Production Environment Configuration
# Copy this file to .env and fill in your actual production values
# NEVER commit the actual .env file to version control

# Django Core Settings
DJANGO_SECRET_KEY=your-very-secret-production-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=crm_prod
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=strong-production-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cache Configuration (Redis)
REDIS_URL=redis://redis:6379/0

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Django Superuser (used by entrypoint.sh for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=strong-admin-password
